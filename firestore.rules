rules_version = '2';

// Security for Tweak. The client is never trusted: plan limits, ownership and
// who-can-see-what are all enforced here.
// Collection names are prefixed (tweak_ / tweaks_) and must match src/lib/collections.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/tweak_users/$(uid); }
    function projectPath(id) { return /databases/$(database)/documents/tweaks_projects/$(id); }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // The plan someone has RIGHT NOW: "pro" only while it has not run out. `planUntil` is written by the billing worker
    // after a confirmed payment; a plan with no `planUntil` (set by hand) never runs out.
    function planOf(data) {
      return data.get('plan', 'free') == 'pro' && (!('planUntil' in data) || data.planUntil > request.time) ? 'pro' : 'free';
    }

    // Keep in sync with src/features/billing/plans.ts
    function maxProjects(plan) { return plan == 'pro' ? 100 : 10; }
    // Downloads per page per month; Pro is unlimited (a very large number).
    function maxDownloads(plan) { return plan == 'pro' ? 1000000000 : 10; }
    // Month as a number, e.g. 202609 (UTC) — the client uses the same format.
    function thisMonth() { return request.time.year() * 100 + request.time.month(); }

    // ---- tweak_users/{uid}: profile + page counter -------------------------
    match /tweak_users/{uid} {
      allow read: if isUser(uid);

      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'plan', 'projectCount', 'createdAt'])
        && request.resource.data.plan == 'free'
        && request.resource.data.projectCount == 0
        && request.resource.data.createdAt == request.time;

      // The counter may only move by one, together with the project it belongs
      // to (lastProjectOp) appearing or disappearing in the same batch.
      allow update: if isUser(uid) && (profileEdit() || repairProfile() || countUp(uid) || countDown(uid));

      function profileEdit() { return changedOnly(['displayName', 'photoURL']); }

      // The profile doc may already exist from another app in the same Firebase
      // project. Allow adding ONLY our counter (+ plan "free" when absent).
      function repairProfile() {
        return !('projectCount' in resource.data)
          && request.resource.data.projectCount == 0
          && (
            (('plan' in resource.data) && changedOnly(['projectCount']))
            || (!('plan' in resource.data) && changedOnly(['projectCount', 'plan']) && request.resource.data.plan == 'free')
          );
      }
      function opId() { return request.resource.data.lastProjectOp; }

      function countUp(uid) {
        return changedOnly(['projectCount', 'lastProjectOp'])
          && request.resource.data.projectCount == resource.data.projectCount + 1
          && request.resource.data.projectCount <= maxProjects(planOf(resource.data))
          && !exists(projectPath(opId()))
          && existsAfter(projectPath(opId()))
          && getAfter(projectPath(opId())).data.ownerId == uid;
      }

      function countDown(uid) {
        return changedOnly(['projectCount', 'lastProjectOp'])
          && request.resource.data.projectCount == resource.data.projectCount - 1
          && exists(projectPath(opId()))
          && get(projectPath(opId())).data.ownerId == uid
          && !existsAfter(projectPath(opId()));
      }
    }

    // ---- tweaks_projects/{id}: listable metadata ----------------------------
    match /tweaks_projects/{projectId} {
      allow read: if resource.data.isPublic == true || isUser(resource.data.ownerId);

      allow create: if isUser(request.resource.data.ownerId)
        && request.resource.data.isPublic == false
        && !('downloadCount' in request.resource.data) && !('downloadPeriod' in request.resource.data)
        && getAfter(userPath(request.auth.uid)).data.lastProjectOp == projectId
        && getAfter(userPath(request.auth.uid)).data.projectCount == get(userPath(request.auth.uid)).data.projectCount + 1;

      allow update: if isUser(resource.data.ownerId) && (metaEdit() || countDownload());

      function metaEdit() {
        return changedOnly(['name', 'isPublic', 'thumbnailUrl', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 200;
      }

      // One more download this month, within the plan (count restarts each month).
      function countDownload() {
        let sameMonth = resource.data.get('downloadPeriod', 0) == thisMonth();
        let before = sameMonth ? resource.data.get('downloadCount', 0) : 0;
        return changedOnly(['downloadPeriod', 'downloadCount'])
          && request.resource.data.downloadPeriod == thisMonth()
          && request.resource.data.downloadCount == before + 1
          && request.resource.data.downloadCount <= maxDownloads(planOf(get(userPath(request.auth.uid)).data));
      }

      allow delete: if isUser(resource.data.ownerId)
        && getAfter(userPath(request.auth.uid)).data.lastProjectOp == projectId
        && getAfter(userPath(request.auth.uid)).data.projectCount == get(userPath(request.auth.uid)).data.projectCount - 1;
    }

    // ---- tweaks_project_content/{id}: the page itself ----------------------
    match /tweaks_project_content/{projectId} {
      allow read: if resource.data.isPublic == true || isUser(resource.data.ownerId);

      allow create: if isUser(request.resource.data.ownerId)
        && request.resource.data.isPublic == false
        && getAfter(projectPath(projectId)).data.ownerId == request.auth.uid;

      // isPublic is a mirror of the project's flag and must match it.
      allow update: if isUser(resource.data.ownerId)
        && changedOnly(['doc', 'updatedAt', 'isPublic'])
        && request.resource.data.isPublic == getAfter(projectPath(projectId)).data.isPublic;

      allow delete: if isUser(resource.data.ownerId);
    }

    // ---- tweaks_payments/{id}: payment records, written ONLY by the billing worker ------
    // A person can read their own payments (the Plans page shows them) and nothing else: no client writes at all.
    match /tweaks_payments/{paymentId} {
      allow read: if isUser(resource.data.ownerId);
      allow write: if false;
    }

    // ---- marketplace -----------------------------------------------------------------
    // tweaks_listings/{id}: a page for sale. Anyone may read an ACTIVE listing; the seller manages their own.
    // `salesCount` is written only by the billing worker, so it is not in the lists below.
    match /tweaks_listings/{listingId} {
      function listingOk() {
        return request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
          && request.resource.data.description is string && request.resource.data.description.size() <= 1000
          && request.resource.data.priceUsd is number && request.resource.data.priceUsd >= 1 && request.resource.data.priceUsd <= 500
          && request.resource.data.status in ['active', 'paused']
          && (request.resource.data.thumbnailUrl == null || request.resource.data.thumbnailUrl is string)
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if resource.data.status == 'active' || isUser(resource.data.ownerId);

      allow create: if isUser(request.resource.data.ownerId)
        && request.resource.data.keys().hasOnly(['ownerId', 'sellerName', 'projectId', 'title', 'description', 'priceUsd', 'thumbnailUrl', 'status', 'salesCount', 'createdAt', 'updatedAt'])
        && request.resource.data.salesCount == 0
        && request.resource.data.createdAt == request.time
        && get(projectPath(request.resource.data.projectId)).data.ownerId == request.auth.uid
        && listingOk();

      // The price and words may change; a sale already made keeps the price it was made at (it is stored on the order).
      allow update: if isUser(resource.data.ownerId)
        && changedOnly(['title', 'description', 'priceUsd', 'thumbnailUrl', 'status', 'updatedAt'])
        && listingOk();

      allow delete: if isUser(resource.data.ownerId) && resource.data.salesCount == 0;
    }

    // tweaks_orders/{id}, tweaks_ledger/{id}, tweaks_payouts/{id}: money records. Buyer and seller can read their own; only the
    // billing worker writes them.
    match /tweaks_orders/{orderId} {
      allow read: if isUser(resource.data.buyerId) || isUser(resource.data.sellerId);
      allow write: if false;
    }
    match /tweaks_ledger/{entryId} {
      allow read: if isUser(resource.data.sellerId);
      allow write: if false;
    }
    match /tweaks_payouts/{payoutId} {
      allow read: if isUser(resource.data.sellerId);
      allow write: if false;
    }

    // ---- tweaks_components/{id}: one saved component of someone's library ---
    // Private to the owner. `data` is the packed component (a small string), `version` counts the saves.
    match /tweaks_components/{entryId} {
      function validEntry() {
        return request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.data is string && request.resource.data.data.size() <= 200000
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if isUser(resource.data.ownerId);

      allow create: if isUser(request.resource.data.ownerId)
        && request.resource.data.keys().hasOnly(['ownerId', 'name', 'data', 'version', 'createdAt', 'updatedAt'])
        && request.resource.data.version == 1
        && request.resource.data.createdAt == request.time
        && validEntry();

      allow update: if isUser(resource.data.ownerId)
        && changedOnly(['name', 'data', 'version', 'updatedAt'])
        && request.resource.data.version == resource.data.version + 1
        && validEntry();

      allow delete: if isUser(resource.data.ownerId);
    }
  }
}
