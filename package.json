    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "html-to-image": "^1.11.13",
    "konva": "^10.7.0",
    "parchment": "^3.0.0",
    "quill": "^2.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
