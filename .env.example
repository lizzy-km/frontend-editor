# Firebase web config (Project settings -> Your apps -> Web app).
# NOTE: every VITE_* value is inlined into the public JS bundle. These are
# identifiers, not secrets — security comes from firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Google Analytics for Firebase (G-XXXXXXX). Empty = no usage stats are sent.
VITE_FIREBASE_MEASUREMENT_ID=
# Set to 1 to also send usage stats from `vite dev` (shows up in DebugView).
VITE_ANALYTICS_IN_DEV=

# URL of the deployed Cloudflare Worker in workers/assets (image uploads to R2),
# e.g. https://tweak-assets.<you>.workers.dev. NOT the bucket's r2.dev address:
# that one can only be read, so uploads are switched off for it.
# Leave empty to disable uploads (users can still paste image links).
VITE_ASSETS_URL=
