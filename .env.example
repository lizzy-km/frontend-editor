# Firebase web config (Project settings -> Your apps -> Web app).
# NOTE: every VITE_* value is inlined into the public JS bundle. These are
# identifiers, not secrets — security comes from firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL of the Cloudflare Worker in workers/assets (image uploads to R2).
# Leave empty to disable uploads (users can still paste image links).
VITE_ASSETS_URL=
